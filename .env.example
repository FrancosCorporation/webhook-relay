# Gere um valor aleatório: openssl rand -hex 32
NODE_ENV=production
HOST=127.0.0.1
RELAY_SECRET=
PORT=3400
RELAY_DB=./webhook-relay.db

# HTTPS é obrigatório por padrão. 1 permite HTTP público; endereços privados
# continuam bloqueados para evitar SSRF.
RELAY_ALLOW_HTTP=0

# Opcional: hosts exatos separados por vírgula, por exemplo hooks.exemplo.com,api.exemplo.com
RELAY_ALLOWED_HOSTS=

# Só use 1 atrás de um proxy confiável; o relay confiará em um salto de X-Forwarded-For.
RELAY_TRUST_PROXY=0
